# Template for the repo-root .env (server / gateway). Copy to .env and adjust.
# Priority: .env value -> default in apps/server/src/config.ts. The values below are those defaults.
# A variable set in the shell for a one-off run (e.g. $env:STRESS="1") still overrides the file.

# --- Gateway ---
PORT=8080
GATEWAY_ID=gw-a
# Devices this gateway accepts: empty or * = all, or a list like dev-1,dev-2,dev-3
DEVICE_FILTER=

# --- Device link (two gateways: npm run dev:mesh sets these per process) ---
# Empty = the gateway runs the simulator in-process; otherwise the separate simulator's
# WebSocket, e.g. ws://localhost:8079/devices
SIM_URL=
# Fixed extra delay of every device message before chaos, ms (makes one gateway slower)
LINK_LATENCY_MS=0
# Port of the separate simulator process (npm run dev:mesh); not used by a gateway
SIM_PORT=8079

# --- Presence, history, delivery ---
# A device silent this long is reported offline, ms. Must exceed CHAOS_MAX_DELAY_MS,
# otherwise delayed messages make devices flap between online and offline.
OFFLINE_AFTER_MS=5000
# Per-device history buffer used for snapshots and replay: whichever limit is hit first
HISTORY_MAX_MESSAGES=500
HISTORY_MAX_AGE_MS=60000
# Resume: a per-device answer with more messages than this is sent as a snapshot instead of a replay
REPLAY_MAX_MESSAGES=300
# Resume: events received up to this long before the client's cursor message are replayed too,
# because a chaos-delayed event can carry a seq below the cursor, ms (must exceed CHAOS_MAX_DELAY_MS)
REPLAY_EVENT_LOOKBACK_MS=5000
# Live messages are sent to clients in batches this often, ms
BATCH_INTERVAL_MS=50
# WebSocket ping interval; a client that misses one pong is disconnected, ms
WS_PING_INTERVAL_MS=10000

# --- Throttling, backpressure ---
# State updates per second per device sent to a client until it subscribes with its own maxHz;
# 0 = no limit. Events and presence are never limited.
DEFAULT_MAX_HZ=10
# Bytes waiting in a client's socket above which nothing more is sent to it on that tick
# (states keep coalescing in per-device slots meanwhile), bytes
WS_BACKPRESSURE_BYTES=524288
# Events + presence (+ states when maxHz is unlimited) queued for one client; on overflow the
# queue is cleared and the client gets `resync`, so memory per slow client stays bounded
CLIENT_QUEUE_MAX=1000

# --- Simulator ---
# 1..8 virtual devices
DEVICE_COUNT=8
# 1 = start in stress mode (~125 msg/s per device, ~1000 msg/s total); also toggled at runtime
# from the UI or POST /debug/stress
STRESS=0
# Multiplier for offline / reboot / sensor-spike intervals (0.1 = ten times more often)
SIM_LIFECYCLE_SCALE=1

# --- Network chaos (between devices and gateway) ---
CHAOS_DELAY_PROB=0.2
CHAOS_MIN_DELAY_MS=100
CHAOS_MAX_DELAY_MS=3000
CHAOS_DUP_PROB=0.05
CHAOS_DUP_MAX_DELAY_MS=1000

# --- Debug logging ---
# 1 = log device lifecycle (offline / online / reboot)
DEBUG_SIM=0
# 1 = all devices, or a list like dev-1,dev-2; empty or 0 = off
DEBUG_INGEST=0
