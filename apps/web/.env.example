# Template for apps/web/.env (web client). Copy to .env and adjust; Vite loads it automatically.
# Priority: .env value -> default in apps/web/src/config.ts. The values below are those defaults.

# --- Gateway ---
# Gateway WebSocket endpoints, comma-separated. With several (npm run dev:mesh sets
# ws://localhost:8080/ws,ws://localhost:8081/ws) the client keeps a connection to each and merges
# their streams; the first reachable one in the list is primary and receives control messages
VITE_WS_URLS=ws://localhost:8080/ws

# --- Connection ---
# Reconnect uses exponential backoff with full jitter: delay = random(0, min(MAX, BASE * 2^attempt)), ms
VITE_RECONNECT_BASE_MS=500
VITE_RECONNECT_MAX_MS=10000
# No data at all (not even a server heartbeat, sent every 1 s when idle) for this long = dead link, ms
VITE_CONNECTION_TIMEOUT_MS=4000
